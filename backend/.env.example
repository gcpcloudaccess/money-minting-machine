# --- LLM provider (required: set at least one key) ---
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Optional news API (falls back to free RSS if unset) ---
NEWSAPI_KEY=

# --- Data mode ---
# live   = pull real-time/delayed quotes via yfinance while NSE is open (app/data/exchanges.py)
# replay = replay cached recent historical intraday bars at accelerated speed, works any time (demo-friendly)
DATA_MODE=replay
REPLAY_EXCHANGE=NSE

# --- Database ---
DATABASE_URL=sqlite:///./investment_committee.db
# Optional: switch persistence to Firestore instead of the local SQLite file above.
# Set this to your GCP project id to enable it - worth doing if this runs somewhere with
# an ephemeral local disk (e.g. Cloud Run without a mounted volume), since SQLite's file
# otherwise gets wiped on every container restart/redeploy. Leave empty to keep using SQLite.
# Requires: Firestore API enabled + a Firestore database (Native mode) created in that
# project, and the running service's account having the Cloud Datastore User role.
FIRESTORE_PROJECT_ID=

# --- Trading session parameters ---
STARTING_CAPITAL_INR=100000
LEVERAGE=1
SESSION_HOURS=4
TICK_MINUTES=5
# How many symbols get the full 14-agent committee per tick - the main lever on how fast
# a decision lands (each symbol takes ~30-90s wall-clock), not TICK_MINUTES alone.
MAX_SYMBOLS_PER_TICK=1
# Nifty 50 index directly (^NSEI - no NSE futures data via yfinance, so this is a paper-only
# synthetic position) + MCX gold/silver via their NSE-listed ETF proxies
WATCHLIST=^NSEI,GOLDBEES.NS,SILVERBEES.NS

# Investment Planner's asset-allocation caps and profit/loss goals - conservative | moderate | aggressive
RISK_TOLERANCE=moderate

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Concurrency ---
# Caps concurrent LLM calls when agents run in parallel. Raise if your API tier
# comfortably handles more; too high trips rate limits and retries end up slower.
MAX_PARALLEL_AGENTS=4

# --- Optional: India macro data for the Macroeconomist Analyst's regime model ---
# No free live feed for these is wired up. Leave unset to use the news-sentiment-only
# reading, or fill in from RBI (repo rate) / MOSPI (GDP, CPI inflation) bulletins -
# they move slowly, so periodic manual updates are fine.
MACRO_GDP_GROWTH_PCT=2.5
MACRO_INFLATION_PCT=3.1
MACRO_POLICY_RATE_PCT=5.25
MACRO_DATA_AS_OF=

# --- Positional options picks (see app/orchestration/positional_scanner.py) ---
# Nifty 50 + Bank Nifty get real options structures (listed NSE index options); Gold/Silver
# ETF proxies + BTC get directional positional calls only (no options chain available for those).
POSITIONAL_UNIVERSE=^NSEI,^NSEBANK,GOLDBEES.NS,SILVERBEES.NS,BTCINR
# 0=Monday...6=Sunday. NSE has changed the index weekly-expiry weekday before - fix here, not in code, when it moves again.
OPTIONS_EXPIRY_WEEKDAY=1
MIN_DAYS_TO_EXPIRY_POSITIONAL=7
MAX_DAYS_TO_EXPIRY_POSITIONAL=45
# No free live feed for RBI MPC dates - comma-separated ISO dates from rbi.org.in, e.g. 2026-08-06,2026-10-01
RBI_MPC_DATES=
